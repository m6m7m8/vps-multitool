# Токен бота от @BotFather
BOT_TOKEN=

# Ваш числовой Telegram ID (можно оставить пустым, если используете одноразовый BIND_CODE)
ADMIN_IDS=

# Одноразовый код привязки первого админа (если ADMIN_IDS пустой)
BIND_CODE=

# Начальный PIN/пароль на вход в бота (оставьте пустым, чтобы отключить)
INITIAL_PIN=

# Ключ Gemini API (бесплатно на https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Модель по умолчанию
GEMINI_MODEL=gemini-3.8-flash

DB_PATH=/app/data/multitool.sqlite3
